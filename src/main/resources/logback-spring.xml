<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Human-readable console for local dev and tests; structured JSON everywhere else.
         requestId (public) and traceId/spanId (internal) ride the MDC into every line. -->
    <springProfile name="local,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [rid=%X{requestId:-}] [org=%X{org_id:-}] [trace=%X{traceId:-}] %logger{36} : %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!local &amp; !test">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"enterprise-modulith-template"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
