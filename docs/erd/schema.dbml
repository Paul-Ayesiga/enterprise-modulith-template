  org_id uuid [not null]
  url varchar(2048) [not null]
  secret varchar(200) [not null]
  event_types text [not null]
  status varchar(20) [not null]
  version bigint [not null]
  created_at timestamptz [not null]
  created_by varchar(100)
  updated_at timestamptz
  updated_by varchar(100)
  deleted_at timestamptz
  Note: 'webhooks module'
}

// ---- Real foreign keys (10, all intra-module) ----
Ref: exchange_job_error.job_id > exchange_job.id
Ref: integration_setting.integration_id > integration.id
Ref: membership.role_id > org_role.id
Ref: org_group_member.group_id > org_group.id
Ref: org_subscription.plan_id > plan.id
Ref: plan_entitlement.plan_id > plan.id
Ref: role_permission.role_id > org_role.id
Ref: ticket_message.ticket_id > ticket.id
Ref: user_contact.profile_id > user_profile.id
Ref: webhook_delivery.subscription_id > webhook_subscription.id

// ---- Soft references (cross-module; NOT enforced by any DB FK) ----
Ref: api_key.org_id > organization.kc_org_id [color: #b0653a]
