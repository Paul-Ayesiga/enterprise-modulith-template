# Copy to docker/.env and adjust. Every value has a working default —
# override only what clashes on your machine (e.g. a local Postgres already on 5432).
# The same variable names feed Kustomize configMapGenerator when this moves to Kubernetes.

# App server port (the Spring app itself, not a Compose service — `make run`/bootRun reads it)
SERVER_PORT=8080

# API gateway ports (`make gateway`): the edge and its admin/management port. If the whole stack
# clashes on your machine, a simple fix is one prefix on every port here (e.g. 2xxxx: SERVER_PORT=28080,
# GATEWAY_PORT=28090, POSTGRES_PORT=25432, …). NOTE the gateway must NOT reuse SERVER_PORT — the Makefile
# rebinds it, and `make run` is root-scoped (:bootRun) so it never also starts the gateway.
GATEWAY_PORT=8090
GATEWAY_ADMIN_PORT=9090

# Postgres (host-side port mapping; inside the network it is always 5432)
POSTGRES_DB=modulith
POSTGRES_USER=modulith
POSTGRES_PASSWORD=modulith
POSTGRES_PORT=5432

# Keycloak (dev realm smsone auto-imported; one dev user: paul/Paul123, platform-superadmin)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Valkey (Redis-compatible cache + locks)
VALKEY_PORT=6379

# SeaweedFS (creds live in docker/seaweedfs/s3-config.json)
S3_PORT=8333            # S3 API endpoint
SEAWEED_FILER_PORT=8888 # Filer web UI (browse objects)
SEAWEED_MASTER_PORT=9333 # Master web UI (cluster status)

# Mailpit (dev email sink)
MAILPIT_UI_PORT=8025
SMTP_PORT=1025

# Observability (grafana/otel-lgtm)
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Kill Bill (billing) — 8080/8081 are taken by the app and Keycloak
KILLBILL_PORT=8082
KAUI_PORT=9095
# Kaui (KB admin UI) runs Rails in production and needs a secret_key_base or it 500s on boot.
# A dev default ships in docker-compose.yml; set your own here to override. Generate: openssl rand -hex 64
KAUI_SECRET_KEY_BASE=
# Set BILLING_BOOTSTRAP=true so the app creates the KB tenant + simple plans on boot,
# and BILLING_CALLBACK_URL=http://host.docker.internal:8080/api/v1/billing/killbill/notifications
# to receive push notifications in dev.
# Set BILLING_AUTO_PROVISION=true so a newly created org auto-provisions its Kill Bill account under
# the smsone tenant (needs the tenant to exist first — bootstrap on, or run `make killbill-init`).

# Integration hub — AES key derivation for secret provider settings (override in prod)
INTEGRATION_SECRET_KEY=smsone-dev-integration-secret-key
