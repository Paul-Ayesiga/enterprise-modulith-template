# Copy to docker/.env and adjust. Every value has a working default —
# override only what clashes on your machine (e.g. a local Postgres already on 5432).
# The same variable names feed Kustomize configMapGenerator when this moves to Kubernetes.

# Postgres (host-side port mapping; inside the network it is always 5432)
POSTGRES_DB=modulith
POSTGRES_USER=modulith
POSTGRES_PASSWORD=modulith
POSTGRES_PORT=5432

# Keycloak (dev realm smsone auto-imported; users david/david123, jane/jane123)
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Valkey (Redis-compatible cache + locks)
VALKEY_PORT=6379

# SeaweedFS (creds live in docker/seaweedfs/s3-config.json)
S3_PORT=8333            # S3 API endpoint
SEAWEED_FILER_PORT=8888 # Filer web UI (browse objects)
SEAWEED_MASTER_PORT=9333 # Master web UI (cluster status)

# Mailpit (dev email sink)
MAILPIT_UI_PORT=8025
SMTP_PORT=1025

# Observability (grafana/otel-lgtm)
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
