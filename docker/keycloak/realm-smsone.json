{
  "realm": "smsone",
  "displayName": "${BRAND_NAME}",
  "loginTheme": "smsone",
  "emailTheme": "smsone",
  "enabled": true,
  "registrationAllowed": false,
  "organizationsEnabled": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@smsone.co.ug",
    "fromDisplayName": "SMSOne",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "platform-superadmin",
        "description": "Platform escalation tier: everything platform-admin can do, plus what only it may authorize (impersonating a platform-role holder). Implies platform-admin via the app's RoleHierarchy."
      },
      {
        "name": "platform-admin",
        "description": "Changes platform behaviour: settings, feature flags, tenant lifecycle. Implies platform-support via the app's RoleHierarchy."
      },
      {
        "name": "platform-support",
        "description": "Read-only platform view: user listing, audit, ops reads. The floor of the platform tier ladder."
      },
      {
        "name": "USER",
        "description": "Standard user"
      }
    ]
  },
  "clientScopes": [
