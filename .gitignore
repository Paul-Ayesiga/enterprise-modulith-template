# Gradle
.gradle/
build/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
out/
# Eclipse / VS Code Java compile output — one bin/ per Gradle project (root + each gateway/*).
# Unanchored so it catches them all; our own scripts live in scripts/, never bin/.
bin/

# OS
.DS_Store

# Environment / secrets — commit .env.example, never .env
.env

# Local k3s: the filled Secret (commit secret.example.yaml only) + any fetched kubeconfig
deploy/k3s-local/**/secret.yaml
*smsone-k3s.yaml

# Local data (DuckDB marts, Parquet snapshots)
/data/
*.duckdb
*.duckdb.wal

# Logs
*.log

# k6 load-test run outputs (the scripts are committed; their results are not)
/perf/out/
